PORT=3000
HOST=127.0.0.1
# Used only by the backend for image moderation and photobooth captions.
GEMINI_API_KEY=
# Defaults used by the current source; change if your Google project requires another model.
MODERATION_MODEL=gemini-3.5-flash-lite
CAPTION_MODEL=gemini-3.5-flash-lite
# Set the same random secret on the web server and the trusted local Flow worker.
# Never expose this value to the browser frontend.
FLOW_WORKER_TOKEN=
